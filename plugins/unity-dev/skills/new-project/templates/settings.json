{
  "env": {
    "UNITY_DEV_STANDARDS": "on"
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/plugins/cache/*/unity-dev/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "narek-skills": {
      "source": {
        "source": "github",
        "repo": "NarekMynell/claude-skills"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "unity-dev@narek-skills": true,
    "unity@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true
  }
}
